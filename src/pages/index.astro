---
const players = [
	{ id: 'player1', label: 'Player 1', placeholder: 'octocat' },
	{ id: 'player2', label: 'Player 2', placeholder: 'mona' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="hero">
				<p class="eyebrow">GitHub Contribution Battle Arena</p>
				<h1>Mona Mayhem</h1>
				<button type="button" class="sfx-toggle" id="sfx-toggle" aria-pressed="false">
					🔊 SFX: ON
				</button>
			</header>

			<section class="arcade-hud" id="arcade-hud" aria-label="Player health bars" hidden>
				<div class="health-panel health-one">
					<div class="health-label">
						<span>PLAYER 1 <strong data-health-name>—</strong></span>
						<span data-health-value="1">100%</span>
					</div>
					<div class="health-track" role="progressbar" aria-label="Player 1 health" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
						<span data-health-fill="1"></span>
					</div>
				</div>
				<strong class="round-label">ROUND 1</strong>
				<div class="health-panel health-two">
					<div class="health-label">
						<span>PLAYER 2 <strong data-health-name>—</strong></span>
						<span data-health-value="2">100%</span>
					</div>
					<div class="health-track" role="progressbar" aria-label="Player 2 health" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
						<span data-health-fill="2"></span>
					</div>
				</div>
			</section>

			<section class="clash-screen" id="clash-screen" aria-live="assertive" aria-atomic="true" hidden>
				<p class="clash-caption">Mona Mayhem</p>
				<strong id="clash-text">VS</strong>
			</section>
			<div class="celebration-layer" id="celebration-layer" aria-hidden="true"></div>

			<form class="battle-panel" id="battle-form">
				<div class="input-grid">
					{players.map((player) => (
						<label class="field" for={player.id}>
							<span>{player.label}</span>
							<input
								id={player.id}
								name={player.id}
								type="text"
								placeholder={player.placeholder}
								autocomplete="off"
							/>
						</label>
					))}
				</div>

				<div class="preset-matchups" aria-label="Quick-select matchups">
					<span class="preset-label">Quick matchups</span>
					<button type="button" class="preset-button" data-player-one="torvalds" data-player-two="gaearon">
						torvalds vs. gaearon
					</button>
					<button type="button" class="preset-button" data-player-one="octocat" data-player-two="sindresorhus">
						octocat vs. sindresorhus
					</button>
				</div>

				<button type="submit" class="battle-button" id="battle-button">BATTLE!</button>
			</form>

			<section class="status-panel" role="status" aria-live="polite" aria-atomic="true">
				<p class="status-text ready-indicator" id="status-message">
					<span>INSERT COIN</span><span class="status-divider"> / </span><span>READY PLAYER 1</span>
				</p>
			</section>

			<section class="scoreboard" id="scoreboard" aria-label="Battle score summary" hidden>
				<div class="winner-banner">
					<span class="winner-label" id="winner-label">Winner</span>
					<strong id="winner-name">—</strong>
				</div>
				<div class="score-summary">
					<div>
						<span class="summary-label" id="player-one-score-label">Player 1 Battle Score</span>
						<strong id="player-one-score">—</strong>
					</div>
					<div>
						<span class="summary-label" id="player-two-score-label">Player 2 Battle Score</span>
						<strong id="player-two-score">—</strong>
					</div>
				</div>
				<div class="stats-table-wrap">
					<table class="stats-table">
						<thead>
							<tr>
								<th scope="col">Battle stat</th>
								<th scope="col" id="stats-player-one">Player 1</th>
								<th scope="col" id="stats-player-two">Player 2</th>
							</tr>
						</thead>
						<tbody>
							<tr data-stat-row="total">
								<th scope="row">Total contributions</th>
								<td data-stat-value="total" data-player-stat="1">—</td>
								<td data-stat-value="total" data-player-stat="2">—</td>
							</tr>
							<tr data-stat-row="longest">
								<th scope="row">Longest streak</th>
								<td data-stat-value="longest" data-player-stat="1">—</td>
								<td data-stat-value="longest" data-player-stat="2">—</td>
							</tr>
							<tr data-stat-row="current">
								<th scope="row">Current streak</th>
								<td data-stat-value="current" data-player-stat="1">—</td>
								<td data-stat-value="current" data-player-stat="2">—</td>
							</tr>
							<tr data-stat-row="peak">
								<th scope="row">Most active day</th>
								<td data-stat-value="peak" data-player-stat="1">—</td>
								<td data-stat-value="peak" data-player-stat="2">—</td>
							</tr>
							<tr data-stat-row="consistency">
								<th scope="row">Consistency</th>
								<td data-stat-value="consistency" data-player-stat="1">—</td>
								<td data-stat-value="consistency" data-player-stat="2">—</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section class="arena" id="arena" aria-label="Contribution comparison arena" hidden>
				<article class="player-card player-one" data-player="1">
					<header class="player-header">
						<div class="avatar avatar-one" data-avatar aria-hidden="true">P1</div>
						<div>
							<p class="player-name" data-username>Player 1</p>
							<p class="player-handle" data-date-range>Waiting for battle</p>
						</div>
					</header>
					<p class="fighter-class" data-class-badge aria-label="Fighter class">CLASS: —</p>
					<div class="player-summary">
						<strong data-total>—</strong>
						<span>contributions in the past year</span>
					</div>
					<div class="grid-scroll">
						<div class="grid-placeholder" data-grid role="img" aria-label="Contribution activity heatmap"></div>
					</div>
				</article>

				<div class="versus" aria-hidden="true">VS</div>

				<article class="player-card player-two" data-player="2">
					<header class="player-header">
						<div class="avatar avatar-two" data-avatar aria-hidden="true">P2</div>
						<div>
							<p class="player-name" data-username>Player 2</p>
							<p class="player-handle" data-date-range>Waiting for battle</p>
						</div>
					</header>
					<p class="fighter-class" data-class-badge aria-label="Fighter class">CLASS: —</p>
					<div class="player-summary">
						<strong data-total>—</strong>
						<span>contributions in the past year</span>
					</div>
					<div class="grid-scroll">
						<div class="grid-placeholder" data-grid role="img" aria-label="Contribution activity heatmap"></div>
					</div>
				</article>
			</section>
		</main>
	</body>
</html>

<script>
	import { createArcadeSfx } from '../scripts/arcade-sfx';
	import { calculatePlayerMetrics, scoreBattle } from '../lib/contributions';
	import type { ContributionData } from '../lib/contributions';

	interface ApiError {
		error?: string;
	}

	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerInputs = [
		document.querySelector<HTMLInputElement>('#player1'),
		document.querySelector<HTMLInputElement>('#player2'),
	];
	const statusMessage = document.querySelector<HTMLElement>('#status-message');
	const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
	const scoreboard = document.querySelector<HTMLElement>('#scoreboard');
	const arena = document.querySelector<HTMLElement>('#arena');
	const arcadeHud = document.querySelector<HTMLElement>('#arcade-hud');
	const clashScreen = document.querySelector<HTMLElement>('#clash-screen');
	const clashText = document.querySelector<HTMLElement>('#clash-text');
	const pageShell = document.querySelector<HTMLElement>('.page-shell');
	const celebrationLayer = document.querySelector<HTMLElement>('#celebration-layer');
	const sfx = createArcadeSfx(document.querySelector<HTMLButtonElement>('#sfx-toggle'));

	const formatNumber = new Intl.NumberFormat();
	let presetTriggeredSubmit = false;
	const wait = (milliseconds: number) =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches
			? Promise.resolve()
			: new Promise<void>((resolve) => window.setTimeout(resolve, milliseconds));

	document.querySelectorAll<HTMLButtonElement>('.preset-button').forEach((button) => {
		button.addEventListener('click', () => {
			const [playerOne, playerTwo] = playerInputs;
			if (!playerOne || !playerTwo || !form || battleButton?.disabled) return;

			sfx.playCoin();
			playerOne.value = button.dataset.playerOne ?? '';
			playerTwo.value = button.dataset.playerTwo ?? '';
			presetTriggeredSubmit = true;
			form.requestSubmit();
		});
	});

	function setStatus(message: string, isError = false) {
		if (!statusMessage) return;
		statusMessage.textContent = message;
		statusMessage.classList.remove('ready-indicator');
		statusMessage.classList.toggle('error', isError);
	}

	function syncBattleUrl(playerOne: string, playerTwo: string) {
		const url = new URL(window.location.href);
		url.searchParams.set('p1', playerOne);
		url.searchParams.set('p2', playerTwo);
		window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
	}

	async function playClashSequence() {
		if (!clashScreen || !clashText) return;
		clashScreen.hidden = false;
		for (const [index, callout] of ['VS', '3', '2', '1', 'FIGHT!'].entries()) {
			clashText.textContent = callout;
			clashText.classList.toggle('fight-callout', callout === 'FIGHT!');
			await wait(index === 0 ? 350 : 450);
		}
		clashScreen.hidden = true;
	}

	function setHealth(playerNumber: number, health: number) {
		const boundedHealth = Math.max(0, Math.min(100, health));
		const fill = document.querySelector<HTMLElement>(`[data-health-fill="${playerNumber}"]`);
		const value = document.querySelector<HTMLElement>(`[data-health-value="${playerNumber}"]`);
		const track = fill?.parentElement;
		if (fill) fill.style.width = `${boundedHealth}%`;
		if (value) value.textContent = `${boundedHealth}%`;
		track?.setAttribute('aria-valuenow', String(boundedHealth));
	}

	function resetBattleSequence(playerOne: string, playerTwo: string) {
		if (arcadeHud) arcadeHud.hidden = false;
		document.querySelectorAll<HTMLElement>('[data-health-name]').forEach((name, index) => {
			name.textContent = index === 0 ? playerOne : playerTwo;
		});
		setHealth(1, 100);
		setHealth(2, 100);
		document.querySelectorAll<HTMLElement>('[data-stat-row]').forEach((row) => {
			row.classList.add('stat-pending');
			row.classList.remove('player-one-wins', 'player-two-wins', 'stat-tie', 'stat-revealed');
			row.querySelectorAll<HTMLElement>('[data-player-stat]').forEach((cell) => {
				cell.classList.remove('stat-winner', 'stat-tied');
				cell.textContent = '—';
			});
		});
		const banner = document.querySelector<HTMLElement>('.winner-banner');
		banner?.classList.remove('is-final');
		if (banner) banner.setAttribute('data-result', '');
		if (pageShell) pageShell.classList.remove('screen-shake');
	}

	function clearPreviousBattle() {
		if (scoreboard) scoreboard.hidden = true;
		if (arena) arena.hidden = true;
		if (arcadeHud) arcadeHud.hidden = true;
		if (clashScreen) clashScreen.hidden = true;
		document.querySelectorAll<HTMLElement>('[data-player]').forEach((card) => {
			const username = card.querySelector<HTMLElement>('[data-username]');
			const dateRange = card.querySelector<HTMLElement>('[data-date-range]');
			const total = card.querySelector<HTMLElement>('[data-total]');
			const avatar = card.querySelector<HTMLElement>('[data-avatar]');
			const classBadge = card.querySelector<HTMLElement>('[data-class-badge]');
			const grid = card.querySelector<HTMLElement>('[data-grid]');
			if (username) username.textContent = 'Player';
			if (dateRange) dateRange.textContent = 'Waiting for battle';
			if (total) total.textContent = '—';
			if (avatar) avatar.textContent = 'P';
			if (classBadge) classBadge.textContent = 'CLASS: —';
			grid?.replaceChildren();
		});
	}

	function renderSkeletons() {
		document.querySelectorAll<HTMLElement>('[data-grid]').forEach((grid) => {
			grid.replaceChildren();
			for (let i = 0; i < 364; i += 1) {
				const cell = document.createElement('span');
				cell.className = 'cell skeleton-cell';
				cell.setAttribute('aria-hidden', 'true');
				grid.append(cell);
			}
		});
	}

	async function fetchContributions(username: string, playerNumber: number): Promise<ContributionData> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const payload = (await response.json()) as ContributionData & ApiError;

		if (response.status === 404) {
			throw new Error(`Player ${playerNumber}: GitHub user “${username}” was not found.`);
		}
		if (!response.ok) {
			throw new Error(payload.error ?? `Player ${playerNumber}: Unable to load “${username}”.`);
		}
		if (!Array.isArray(payload.daily)) {
			throw new Error(`Player ${playerNumber}: GitHub returned invalid contribution data.`);
		}

		return payload;
	}

	function renderPlayer(playerNumber: number, data: ContributionData) {
		const card = document.querySelector<HTMLElement>(`[data-player="${playerNumber}"]`);
		if (!card) return;

		const days = data.daily.slice(-364);
		const grid = card.querySelector<HTMLElement>('[data-grid]');
		const username = card.querySelector<HTMLElement>('[data-username]');
		const dateRange = card.querySelector<HTMLElement>('[data-date-range]');
		const total = card.querySelector<HTMLElement>('[data-total]');
		const avatar = card.querySelector<HTMLElement>('[data-avatar]');
		const classBadge = card.querySelector<HTMLElement>('[data-class-badge]');

		if (!grid || !username || !dateRange || !total || !avatar || !classBadge) return;

		const metrics = calculatePlayerMetrics(data);
		username.textContent = data.username;
		dateRange.textContent = data.from && data.to ? `${data.from} — ${data.to}` : 'Last 52 weeks';
		total.textContent = formatNumber.format(metrics.total);
		avatar.textContent = data.username.slice(0, 2).toUpperCase();
		classBadge.textContent = metrics.fighterClass;
		classBadge.title = metrics.classDescription;
		classBadge.setAttribute('aria-label', `${metrics.fighterClass}: ${metrics.classDescription}`);
		grid.replaceChildren();
		grid.setAttribute('aria-label', `${data.username} contribution activity for the last 52 weeks`);

		for (const day of days) {
			const cell = document.createElement('span');
			const level = Math.max(0, Math.min(4, Math.floor(day.level)));
			cell.className = 'cell heatmap-cell';
			cell.dataset.level = String(level);
			cell.title = `${day.date}: ${day.count} contribution${day.count === 1 ? '' : 's'}`;
			cell.setAttribute('aria-label', cell.title);
			grid.append(cell);
		}
	}

	async function animateHeatmaps() {
		const grids = [...document.querySelectorAll<HTMLElement>('[data-grid]')];
		for (let column = 0; column < 52; column += 1) {
			grids.forEach((grid) => {
				for (let row = 0; row < 7; row += 1) {
					grid.children.item(column * 7 + row)?.classList.add('is-revealed');
				}
			});
			await wait(22);
		}
	}

	async function renderBattleScore(playerOne: ContributionData, playerTwo: ContributionData) {
		const result = scoreBattle(playerOne, playerTwo);
		const health = [100, 100];

		for (const [index, category] of result.categories.entries()) {
			sfx.playHit();
			const { id, playerOneValue: one, playerTwoValue: two, winner } = category;
			const row = document.querySelector<HTMLElement>(`[data-stat-row="${id}"]`);
			const oneCell = row?.querySelector<HTMLElement>('[data-player-stat="1"]');
			const twoCell = row?.querySelector<HTMLElement>('[data-player-stat="2"]');

			if (id === 'peak') {
				const peakOne = `${formatNumber.format(one)} (${result.playerOne.peakDate})`;
				const peakTwo = `${formatNumber.format(two)} (${result.playerTwo.peakDate})`;
				if (oneCell) oneCell.textContent = peakOne;
				if (twoCell) twoCell.textContent = peakTwo;
			} else if (id === 'consistency') {
				if (oneCell) oneCell.textContent = `${one.toFixed(1)}%`;
				if (twoCell) twoCell.textContent = `${two.toFixed(1)}%`;
			} else {
				if (oneCell) oneCell.textContent = formatNumber.format(one);
				if (twoCell) twoCell.textContent = formatNumber.format(two);
			}

			row?.classList.remove('player-one-wins', 'player-two-wins', 'stat-tie', 'stat-pending');
			oneCell?.classList.remove('stat-winner', 'stat-tied');
			twoCell?.classList.remove('stat-winner', 'stat-tied');

			if (winner === 1) {
				health[1] = Math.max(0, health[1] - 20);
				setHealth(2, health[1]);
				row?.classList.add('player-one-wins');
				oneCell?.classList.add('stat-winner');
			} else if (winner === 2) {
				health[0] = Math.max(0, health[0] - 20);
				setHealth(1, health[0]);
				row?.classList.add('player-two-wins');
				twoCell?.classList.add('stat-winner');
			} else {
				row?.classList.add('stat-tie');
				oneCell?.classList.add('stat-tied');
				twoCell?.classList.add('stat-tied');
			}
			row?.classList.add('stat-revealed');
			if (index < result.categories.length - 1) await wait(400);
		}

		const winnerLabel = document.querySelector<HTMLElement>('#winner-label');
		const winnerName = document.querySelector<HTMLElement>('#winner-name');
		const playerOneScoreLabel = document.querySelector<HTMLElement>('#player-one-score-label');
		const playerTwoScoreLabel = document.querySelector<HTMLElement>('#player-two-score-label');
		const playerOneScore = document.querySelector<HTMLElement>('#player-one-score');
		const playerTwoScore = document.querySelector<HTMLElement>('#player-two-score');
		const statsPlayerOne = document.querySelector<HTMLElement>('#stats-player-one');
		const statsPlayerTwo = document.querySelector<HTMLElement>('#stats-player-two');

		const isTie = result.winner === null;
		if (winnerLabel) winnerLabel.textContent = isTie ? 'DOUBLE K.O.' : 'VICTORY!';
		if (winnerName) winnerName.textContent = result.winner ?? 'It’s a tie!';
		if (playerOneScoreLabel) playerOneScoreLabel.textContent = `${playerOne.username} Battle Score`;
		if (playerTwoScoreLabel) playerTwoScoreLabel.textContent = `${playerTwo.username} Battle Score`;
		if (playerOneScore) playerOneScore.textContent = `${result.playerOneScore.toFixed(1)} / 5`;
		if (playerTwoScore) playerTwoScore.textContent = `${result.playerTwoScore.toFixed(1)} / 5`;
		if (statsPlayerOne) statsPlayerOne.textContent = playerOne.username;
		if (statsPlayerTwo) statsPlayerTwo.textContent = playerTwo.username;
		const banner = document.querySelector<HTMLElement>('.winner-banner');
		banner?.classList.add('is-final');
		banner?.setAttribute('data-result', isTie ? 'tie' : 'winner');
		pageShell?.classList.add('screen-shake');
		celebrate();
		sfx.playVictory(isTie);
	}

	function celebrate() {
		if (!celebrationLayer) return;
		const colors = ['#55fff0', '#8dff73', '#ff4fd8', '#ffe66d', '#ffffff'];
		for (let index = 0; index < 36; index += 1) {
			const particle = document.createElement('span');
			particle.className = 'celebration-particle';
			particle.style.left = `${Math.random() * 100}%`;
			particle.style.setProperty('--particle-color', colors[index % colors.length]);
			particle.style.setProperty('--particle-delay', `${Math.random() * 450}ms`);
			particle.style.setProperty('--particle-drift', `${Math.round(Math.random() * 180 - 90)}px`);
			celebrationLayer.append(particle);
			window.setTimeout(() => particle.remove(), 2200);
		}
		window.setTimeout(() => pageShell?.classList.remove('screen-shake'), 500);
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (battleButton?.disabled) return;
		if (presetTriggeredSubmit) {
			presetTriggeredSubmit = false;
		} else {
			sfx.playCoin();
		}
		clearPreviousBattle();
		const usernames = playerInputs.map((input) => input?.value.trim() ?? '');

		if (usernames.some((username) => !username)) {
			setStatus('Enter both GitHub usernames before starting the battle.', true);
			playerInputs.find((input) => !input?.value.trim())?.focus();
			return;
		}
		syncBattleUrl(usernames[0], usernames[1]);

		if (!battleButton || !scoreboard || !arena) return;
		battleButton.disabled = true;
		scoreboard.hidden = true;
		arena.hidden = false;
		setStatus('Fetching fighters…');
		resetBattleSequence(usernames[0], usernames[1]);
		renderSkeletons();
		sfx.playPowerUp();

		let clashSequence: Promise<void> | null = null;
		try {
			clashSequence = playClashSequence();
			const [playerOne, playerTwo] = await Promise.all([
				fetchContributions(usernames[0], 1),
				fetchContributions(usernames[1], 2),
			]);
			await clashSequence;

			renderPlayer(1, playerOne);
			renderPlayer(2, playerTwo);
			scoreboard.hidden = false;
			setStatus('Fighters ready! Revealing the arena…');
			await animateHeatmaps();
			await renderBattleScore(playerOne, playerTwo);
			const winner = document.querySelector<HTMLElement>('#winner-name')?.textContent ?? 'It’s a tie!';
			const scoreOne = document.querySelector<HTMLElement>('#player-one-score')?.textContent ?? '0 / 5';
			const scoreTwo = document.querySelector<HTMLElement>('#player-two-score')?.textContent ?? '0 / 5';
			setStatus(`Battle complete. ${winner} — ${playerOne.username} ${scoreOne}, ${playerTwo.username} ${scoreTwo}.`);
		} catch (error) {
			if (clashSequence) await clashSequence;
			if (clashScreen) clashScreen.hidden = true;
			if (arcadeHud) arcadeHud.hidden = true;
			scoreboard.hidden = true;
			arena.hidden = true;
			setStatus(error instanceof Error ? error.message : 'Unable to load contribution data. Please try again.', true);
		} finally {
			battleButton.disabled = false;
		}
